# Base URL of the Spring Boot API (Render Web Service URL in production).
# The browser calls this Next.js app's /api proxy, which forwards to this URL,
# so the API does not need to allow the frontend origin in CORS.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public origin of this frontend (Vercel URL in production) - used for display only
NEXT_PUBLIC_APP_URL=http://localhost:3000
