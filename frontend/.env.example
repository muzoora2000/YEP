# ===========================================================================
# YEP Frontend — environment variables
# Copy this file to .env.local for local development
# ===========================================================================

# Server-side only: URL of the Render backend (never expose to browser).
# In production set this to https://yep-backend.onrender.com in Vercel settings.
BACKEND_URL=http://localhost:8080

# Legacy API proxy target (used by /api/[...path] route). Defaults to BACKEND_URL.
API_PROXY_TARGET=http://localhost:8080

# Public app URL (used for OG tags, QR code links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Note: DATABASE_URL and POSTGRES_URL are added automatically by the
# Vercel-Neon integration. The frontend must NEVER read them directly;
# all database access goes through the backend /api/v1 endpoints.
